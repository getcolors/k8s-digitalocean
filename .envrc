# -*- mode: sh; sh-shell: bash -*-

export DIRENV_WARN_TIMEOUT=20s

eval "$(devenv direnvrc)"

use devenv 2>/dev/null

# Safe to commit: all provider credentials live in the gitignored
# .envrc.private. Missing credentials do not prevent credential-free builds or
# safe dry runs. Run `direnv allow` once after the toolchain is installed.
#
# Never export COLORS_PAR_PROFILE. The profile separates this deployment's
# remote state from every other project sharing the R2 backend.
source_env_if_exists .envrc.private
